# Streamlit Secrets Configuration Example
# Copy this to secrets.toml and fill in your values
# NEVER commit secrets.toml to git!

# Required: Postgres database connection
DATABASE_URL = "postgresql://user:password@host:port/database"

# Optional: LLM API keys (for natural language queries)
GEMINI_API_KEY = "your-gemini-api-key-here"

# Example Supabase connection:
# DATABASE_URL = "postgresql://postgres.[project-ref]:[password]@aws-0-region.pooler.supabase.com:6543/postgres"
