# EdgeDash environment variables
# Copy this file to .env and fill in your own keys.

# Gemini API key (required if llm_provider is "gemini")
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Apify token (required for Apify-based job sources)
APIFY_TOKEN=

# Ollama base URL (optional, defaults to http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434
